---
import { SITE, ASSETS, INSIGHTS_ENABLED } from '../config.ts';
---

<header class="sticky top-0 z-40 bg-nav backdrop-blur">
  <nav class="page-gutter py-5" aria-label="Primary">
    <div class="max-w-content mx-auto flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-3 transition-opacity duration-150 hover:opacity-(--opacity-hover-fade)"
        aria-label={`${SITE.name} home`}
      >
        <img
          src={ASSETS.logo}
          alt=""
          width="48"
          height="48"
          class="h-logo w-auto"
        />
        <span class="font-semibold text-xl text-accent">
          {SITE.name}
        </span>
      </a>

      <ul class="hidden lg:flex items-center gap-6 text-base">
        <li><a href="/mission/" class="text-accent hover:text-link">Mission</a></li>
        {INSIGHTS_ENABLED && (
          <li><a href="/insights/" class="text-accent hover:text-link">Insights</a></li>
        )}
        <li><a href="/contact/" class="text-accent hover:text-link">Contact</a></li>
      </ul>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden -mr-2 p-2 text-accent"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-7 h-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<!--
  The mobile menu is a native <dialog> opened with showModal(). A modal
  dialog is drawn above everything else on the page, and the browser makes
  the rest of the page inert while it is open: keyboard focus, clicks, and
  screen readers stay inside the menu, and the Escape key closes it. It is
  a sibling of the header rather than a child, so the header's
  backdrop-filter never affects how it is positioned.
-->
<dialog id="mobile-menu" class="mobile-menu lg:hidden" aria-label="Site menu">
  <div class="page-gutter py-5">
    <div class="max-w-content mx-auto flex items-center justify-between">
      <a
        href="/"
        class="flex items-center gap-3"
        aria-label={`${SITE.name} home`}
      >
        <img
          src={ASSETS.logo}
          alt=""
          width="48"
          height="48"
          class="h-logo w-auto"
        />
        <span class="font-semibold text-xl text-accent">{SITE.name}</span>
      </a>
      <button
        type="button"
        id="mobile-menu-close"
        class="-mr-2 p-2 text-accent"
        aria-label="Close menu"
      >
        <svg
          class="w-7 h-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18" />
          <line x1="6" y1="18" x2="18" y2="6" />
        </svg>
      </button>
    </div>
  </div>
  <div class="page-gutter mt-8">
    <div class="max-w-content mx-auto flex gap-3">
      <!-- Invisible spacer matching the logo footprint so menu items align
           horizontally with the "MindMotion" wordmark in the header above. -->
      <div class="h-logo w-logo shrink-0" aria-hidden="true"></div>
      <ul class="flex flex-col gap-2 flex-1">
        <li><a href="/mission/" class="block py-3 text-xl font-semibold text-accent hover:text-link">Mission</a></li>
        {INSIGHTS_ENABLED && (
          <li><a href="/insights/" class="block py-3 text-xl font-semibold text-accent hover:text-link">Insights</a></li>
        )}
        <li><a href="/contact/" class="block py-3 text-xl font-semibold text-accent hover:text-link">Contact</a></li>
      </ul>
    </div>
  </div>
</dialog>

<style>
  /* Full-screen menu below the lg breakpoint (1024px), where the menu
     button is shown. Browser default dialog styles (centred box, border,
     padding, white background) are replaced; display is set only while
     open, because a closed dialog must stay display: none. From 1024px up
     this rule does not apply and the lg:hidden class keeps the menu hidden. */
  @media (width < 64rem) {
    .mobile-menu:modal {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      display: flex;
      flex-direction: column;
      background: var(--color-bg);
      color: inherit;
    }
  }
</style>

<script is:inline>
  (function () {
    const toggle = document.getElementById('mobile-menu-toggle');
    const closeBtn = document.getElementById('mobile-menu-close');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !closeBtn || !menu || typeof menu.showModal !== 'function') return;

    // Matches the lg breakpoint, from which the nav shows its links and
    // the menu is hidden.
    const desktop = window.matchMedia('(min-width: 64rem)');

    function open() {
      if (desktop.matches) return;
      menu.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    // Runs however the menu closes: the close button, the Escape key
    // (handled by the browser), widening the window, or returning to this
    // page with the browser's Back button.
    menu.addEventListener('close', function () {
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggle.focus();
    });

    toggle.addEventListener('click', open);
    closeBtn.addEventListener('click', function () { menu.close(); });

    // Choosing a menu link does not close the menu: it stays on screen
    // until the new page replaces it. Closing it first would reveal the
    // current page underneath for a moment before the new page appears.

    // If the visitor comes back with the Back button, the browser may
    // restore this page exactly as it was left, menu still open. Close it.
    window.addEventListener('pageshow', function (e) {
      if (e.persisted && menu.open) menu.close();
    });

    // The menu is hidden from the lg breakpoint (1024px) up. Close it if
    // the window is widened past that while it is open; otherwise the page
    // would stay inert and unscrollable behind an invisible dialog.
    desktop.addEventListener('change', function (e) {
      if (e.matches && menu.open) menu.close();
    });
  })();
</script>
