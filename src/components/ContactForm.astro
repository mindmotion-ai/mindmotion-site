---
/**
 * Contact form: fields, inline validation, and submission to the form
 * provider. On a successful submission it dispatches the document event
 * `mindmotion:contact-success` and shows nothing itself; the page that
 * hosts the form owns the confirmation (see src/pages/contact.astro).
 */
import { CONTACT_FORM_ENDPOINT } from '../config.ts';
const formEndpoint = CONTACT_FORM_ENDPOINT;
---

<form id="contact-form" class="space-y-7" novalidate>
  <input
    type="checkbox"
    name="_gotcha"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    style="position:absolute;left:-9999px"
  />
  <input type="hidden" name="_subject" value="MindMotion contact form submission" />

  <div>
    <label for="name" class="block text-base text-accent mb-2">
      Name
    </label>
    <input
      id="name"
      type="text"
      name="name"
      required
      autocomplete="name"
      aria-describedby="name-error"
      class="form-input w-full px-4 py-3 bg-surface rounded-md focus:outline-none transition-shadow text-base"
    />
    <p id="name-error" class="error-msg mt-2 text-base text-error" hidden>
      Please enter your name.
    </p>
  </div>

  <div>
    <label for="email" class="block text-base text-accent mb-2">
      Email
    </label>
    <input
      id="email"
      type="email"
      name="email"
      required
      autocomplete="email"
      aria-describedby="email-error"
      class="form-input w-full px-4 py-3 bg-surface rounded-md focus:outline-none transition-shadow text-base"
    />
    <p
      id="email-error"
      class="error-msg mt-2 text-base text-error"
      data-invalid-message="Please enter a valid email address."
      hidden
    >
      Please enter your email.
    </p>
  </div>

  <div>
    <label for="organization" class="block text-base text-accent mb-2">
      Organization
    </label>
    <input
      id="organization"
      type="text"
      name="organization"
      required
      autocomplete="organization"
      aria-describedby="organization-error"
      class="form-input w-full px-4 py-3 bg-surface rounded-md focus:outline-none transition-shadow text-base"
    />
    <p id="organization-error" class="error-msg mt-2 text-base text-error" hidden>
      Please enter your organization.
    </p>
  </div>

  <div>
    <label for="message" class="block text-base text-accent mb-2">
      Message
    </label>
    <textarea
      id="message"
      name="message"
      required
      rows="7"
      aria-describedby="message-error"
      class="form-input w-full px-4 py-3 bg-surface rounded-md focus:outline-none transition-shadow text-base resize-y"
    ></textarea>
    <p id="message-error" class="error-msg mt-2 text-base text-error" hidden>
      Please enter a message.
    </p>
    <p class="mt-2 text-sm text-accent-2">
      Please do not submit confidential, proprietary, or other sensitive
      information.
    </p>
  </div>

  <div class="flex flex-col items-start gap-3">
    <button
      type="submit"
      class="px-7 py-3 bg-accent text-bg rounded-md font-semibold text-base hover:bg-accent-2 transition-colors disabled:opacity-(--opacity-disabled) disabled:cursor-not-allowed"
    >
      Send
    </button>
    <p class="text-sm text-accent-2">
      By submitting this form, you agree to our
      <a href="/terms/" class="text-accent font-semibold hover:text-link">Terms of Service</a> and acknowledge our
      <a href="/privacy/" class="text-accent font-semibold hover:text-link">Privacy Policy</a>.
    </p>
  </div>

  <p
    id="contact-error"
    class="text-base text-error"
    role="alert"
    hidden
  >
    Something went wrong. Please try again in a moment.
  </p>
</form>

<style>
  .form-input {
    box-shadow: var(--shadow-input);
    transition: box-shadow 180ms ease;
  }
  .form-input:focus {
    box-shadow: var(--shadow-input-focus);
  }
  .form-input.is-invalid {
    box-shadow: var(--shadow-input-invalid);
  }
  .form-input.is-invalid:focus {
    box-shadow: var(--shadow-input-invalid-focus);
  }
</style>

<script is:inline define:vars={{ formEndpoint }}>
  const form = document.getElementById('contact-form');
  const submitError = document.getElementById('contact-error');
  const submitBtn = form?.querySelector('button[type="submit"]');

  // Each error element's text in the markup is its "field is empty"
  // message; an optional data-invalid-message holds the "value is not
  // valid" message. Remember the empty message once, so switching between
  // the two cases always shows the right one.
  form?.querySelectorAll('.error-msg').forEach((errorEl) => {
    errorEl.dataset.emptyMessage = errorEl.textContent.trim();
  });

  const validateField = (input) => {
    const isEmpty = !input.value.trim();
    const isInvalidEmail =
      input.type === 'email' &&
      input.value.trim() !== '' &&
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim());
    const isInvalid = isEmpty || isInvalidEmail;

    input.setAttribute('aria-invalid', String(isInvalid));
    input.classList.toggle('is-invalid', isInvalid);

    const errorEl = document.getElementById(`${input.id}-error`);
    if (errorEl) {
      errorEl.hidden = !isInvalid;
      errorEl.textContent = isInvalidEmail
        ? errorEl.dataset.invalidMessage
        : errorEl.dataset.emptyMessage;
    }
    return !isInvalid;
  };

  form?.querySelectorAll('[required]').forEach((input) => {
    input.addEventListener('blur', () => validateField(input));
    input.addEventListener('input', () => {
      if (input.getAttribute('aria-invalid') === 'true' && input.value.trim()) {
        validateField(input);
      }
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitError || !submitBtn) return;

    submitError.hidden = true;

    const fields = form.querySelectorAll('[required]');
    let firstInvalid = null;
    fields.forEach((input) => {
      if (!validateField(input) && !firstInvalid) firstInvalid = input;
    });
    if (firstInvalid) {
      firstInvalid.focus();
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch(formEndpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify(data),
      });
      const json = await res.json().catch(() => ({}));
      if (res.ok && (json.ok === true || json.success === true)) {
        document.dispatchEvent(new CustomEvent('mindmotion:contact-success'));
      } else {
        throw new Error('submission failed');
      }
    } catch (err) {
      submitError.hidden = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send';
    }
  });
</script>
