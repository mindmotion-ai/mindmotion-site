---
import { SITE, ASSETS } from '../config.ts';
const year = new Date().getFullYear();
---

<footer class="footer-tint pt-12 md:pt-16 pb-14 page-gutter mt-4">
  <div class="max-w-content mx-auto flex flex-col items-center gap-6 text-center">
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 text-base">
      <li><a href="/privacy/" class="text-accent hover:text-link">Privacy</a></li>
      <li><a href="/terms/" class="text-accent hover:text-link">Terms</a></li>
      <li><a href="/contact/" class="text-accent hover:text-link">Contact</a></li>
    </ul>
    <a href="/" aria-label={`${SITE.name} home`} class="inline-block transition-opacity duration-150 hover:opacity-(--opacity-hover-fade)">
      <img
        src={ASSETS.logo}
        alt=""
        width="48"
        height="48"
        class="h-logo w-auto"
      />
    </a>
    <p class="text-base text-accent-2">© {year} {SITE.legalName}</p>
  </div>
</footer>

<style>
  .footer-tint {
    background: linear-gradient(
      to bottom in srgb,
      transparent 0,
      var(--color-tint-footer) var(--spacing-tint-fade),
      var(--color-tint-footer) 100%
    );
  }
</style>
